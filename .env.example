# 트루무비 0단계 설정. 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋하지 않는다.

# Anthropic API 키
ANTHROPIC_API_KEY=

# 모델 — 사람이 정한다 (기본값 없음). 가격은 100만 토큰당 입력 / 출력.
#   매일 일기 제안: claude-haiku-5-5   ($0.10 / $0.50)
#   주간 감사 제안: claude-opus-5-5    ($4 / $20)  또는 claude-sonnet-5-5 ($2 / $10)
# 가격표에 있는 모델만 쓸 수 있다 (src/cost.ts).
TRUMOVIE_DAILY_MODEL=
TRUMOVIE_AUDIT_MODEL=

# effort: low | medium | high | xhigh | max. 비우면 모델 기본값 (Haiku 5.5, Opus 5.5는 medium)
TRUMOVIE_DAILY_EFFORT=
TRUMOVIE_AUDIT_EFFORT=

# 누적 비용 상한 (달러). 다음 호출이 상한을 넘길 수 있으면 그 전에 멈춘다
TRUMOVIE_BUDGET_USD=10

# 리포트 계산용 가정값
TRUMOVIE_USD_KRW=1400
TRUMOVIE_TARGET_KRW_PER_DAY=50
TRUMOVIE_SUBSCRIPTION_KRW=4900
